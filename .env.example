PIPEDRIVE_API_TOKEN=your_pipedrive_api_token_here

# stdio (default), http, or deprecated sse alias
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_ENABLE_LEGACY_SSE=true
MCP_MAX_SESSIONS=100
MCP_SESSION_IDLE_TIMEOUT_MS=1800000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=

# Required for non-loopback MCP_HOST values. HS256 only; minimum 32 characters.
MCP_JWT_SECRET=
MCP_JWT_AUDIENCE=
MCP_JWT_ISSUER=

# Comma-separated allowlist: move-deal,add-deal-note. Empty is read-only.
PIPEDRIVE_WRITE_TOOLS=

PIPEDRIVE_RATE_LIMIT_MIN_TIME_MS=250
PIPEDRIVE_RATE_LIMIT_MAX_CONCURRENT=2
